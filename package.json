{
  "name": "@payware/mcp-server",
  "version": "1.4.0",
  "mcpName": "io.github.payware/mcp-server",
  "description": "Official MCP server for payware payment API integration",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "payware-mcp": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "proxy": "node src/proxy-server.js",
    "proxy:dev": "node --watch src/proxy-server.js",
    "bridge": "node src/mcp-proxy.js",
    "inspector": "npx @modelcontextprotocol/inspector node src/mcp-proxy.js",
    "test": "node --test tests/api-errors.test.js tests/json-serializer.test.js tests/proxy-server.test.js tests/request-contract.test.js tests/stdio-server.test.js tests/tool-contract.test.js tests/tool-routes.test.js tests/toolsets.test.js",
    "test:watch": "node --test --watch tests/api-errors.test.js tests/json-serializer.test.js tests/proxy-server.test.js tests/request-contract.test.js tests/stdio-server.test.js tests/tool-contract.test.js tests/tool-routes.test.js tests/toolsets.test.js",
    "check": "node --check src/index.js && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "payware",
    "payments",
    "api",
    "fintech",
    "pos",
    "terminal",
    "merchant",
    "isv",
    "oauth2",
    "a2a-payments",
    "account-to-account",
    "instant-payments",
    "transaction-resolution",
    "qr-code-payments"
  ],
  "author": "payware <support@payware.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/payware/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/payware/mcp-server/issues"
  },
  "homepage": "https://github.com/payware/mcp-server#readme",
  "files": [
    "src/",
    "keys/README.md",
    "README.md",
    "check-keys.js",
    "mcp-config.json",
    "payware-mcp-config.json",
    ".env.example",
    "MCP-SETUP.md"
  ]
}
